# Local development values. Copy to .env. Do not use these secrets outside this machine.
# The app runs through Docker Compose. Host Python is not used.

POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel
DATABASE_URL=postgresql+psycopg://sentinel:sentinel@postgres:5432/sentinel

REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=sentinel
MINIO_SECRET_KEY=sentinelsecret
MINIO_BUCKET=snapshots
MINIO_SECURE=false

JWT_SECRET=dev-only-change-this-jwt-secret-32b
JWT_EXPIRE_MINUTES=720
FERNET_KEY=ZsGi5JtC2ol2AH2wYNfSypCwqid_UnHZuvOQEW1N3WA=

BOOTSTRAP_ORG_NAME=Organización demo
BOOTSTRAP_ADMIN_EMAIL=elena.morales@sentinel.com.gt
BOOTSTRAP_ADMIN_PASSWORD=admin12345
BOOTSTRAP_ADMIN_NAME=Elena Morales

# Local edge device. When this is set, the API creates one demo device for the earliest site.
# The worker uses the same value. Video stays on this machine; only events and snapshots go to the API.
BOOTSTRAP_DEVICE_TOKEN=dev-device-token-change-me
EVENT_COOLDOWN_SECONDS=60

# WhatsApp is sent at most once per camera+zone+rule, or per sensor+event type, in this window.
# Panic and smoke ignore it. Events themselves still use EVENT_COOLDOWN_SECONDS.
ALERT_COOLDOWN_SECONDS=600

# Twilio WhatsApp. Leave SID, token, and FROM empty to keep ConsoleProvider (the text is logged, not sent).
# Fill all three to send. FROM is your WhatsApp sender, with or without the whatsapp: prefix.
# Free-form text is a URL-encoded form: From, To, and Body. It is delivered only within 24 hours
# of the recipient's last message to that same sender.
# A Twilio trial cannot create Content Templates, so WhatsApp stays limited to that window.
# TWILIO_CONTENT_SID is optional (an approved template, HX...). It is not sent on the first try.
# It is used only when Twilio rejects the free-form message because the session window is closed
# or ContentSid is required. That template is sent as ContentSid alone, so it must not define placeholders.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_CONTENT_SID=

# Telegram bot token from BotFather. Leave empty to leave Telegram off.
# Alertas lists chats that sent /start to this bot. The admin picks one; nobody types a chat id.
# Event snapshots are uploaded with sendPhoto, so PUBLIC_BASE_URL is not required for Telegram.
TELEGRAM_BOT_TOKEN=

# Public API origin Twilio can fetch, no trailing slash. Leave empty locally:
# snapshots are not reachable from Twilio, so alerts stay text-only.
# Example when you have a tunnel: https://abc.ngrok.io
PUBLIC_BASE_URL=

# Bearer token for the edge sensor webhook. The simulator and the worker share it.
# Compose uses this value. The default below is only for this machine.
SENSOR_WEBHOOK_TOKEN=dev-sensor-webhook-token

# Live view. The API signs a 5-minute token with this secret. The worker checks it.
# The browser opens WORKER_PUBLIC_URL directly. That address is the worker on the site LAN,
# not the cloud API. Video is not proxied. LIVE_CORS_ORIGIN is the web origin allowed to read
# the worker's live status JSON.
LIVE_STREAM_SECRET=dev-live-stream-secret
WORKER_PUBLIC_URL=http://localhost:8081
LIVE_CORS_ORIGIN=http://localhost:3000

# Assistant. LLM_PROVIDER is gemini, openai, or anthropic.
# Leave LLM_MODEL empty to pick an available function-calling model on first use.
# Gemini prefers a Flash-Lite model from the account's model list, then another Flash model.
# On Gemini's free tier, prompts and event metadata may be used by Google to improve its products.
# Use a paid tier before sending real client data.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=
